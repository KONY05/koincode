{
  "permissions": {
    "shell:cd": "allowed",
    "shell:bin:echo": "allowed",
    "shell:bin:sed": "allowed",
    "shell:bin:grep": "allowed",
    "shell:git": "allowed",
    "file:sensitive": "allowed"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "writeFile|editFile",
        "hooks": []
      }
    ]
  },
  "agentPermissions": {
    "BUILD": {
      "shell:bin:gh": "allowed"
    }
  }
}